# ReplayPad v1.2

# ── Stream (obrigatório) ─────────────────────────────────────────────
# URL da câmera (S20 FE via IP Webcam)
STREAM_URL=http://192.168.1.100:8080/video
# STREAM_URL=rtsp://192.168.1.100:554/stream

# ── Tablet (Redmi Pad 2) ────────────────────────────────────────────
TABLET_HOST=0.0.0.0
TABLET_PORT=8000

# Buffer de replay
BUFFER_DURATION=30        # segundos totais (padrão: 30)
SEGMENT_DURATION=5        # segundos por segmento
MAX_SEGMENTS=6            # número de segmentos no ring

# ── VPS (Ubuntu Server) ─────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
DATABASE_URL=postgresql://replaypad:replaypad@localhost/replaypad
STORAGE_PATH=/app/storage

# URL da VPS para upload automático
VPS_URL=http://vps-ip:8001

# ── Geral ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# JPEG_QUALITY=50          # qualidade do JPEG do live stream
